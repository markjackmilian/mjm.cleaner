#include "Base.xcconfig"

// Una sola build universale arm64 + x86_64 (spec §10.2).
SWIFT_COMPILATION_MODE = wholemodule
SWIFT_OPTIMIZATION_LEVEL = -O
ONLY_ACTIVE_ARCH = NO
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym

// Il binario distribuito non deve nominare la macchina che lo ha costruito. Il linker vi lascia la
// mappa di debug (voci SO/OSO di `nm -ap`): percorsi della DerivedData, del checkout e della
// cartella temporanea di Scripts/package-release.sh, diversi a ogni build. `strip -S` toglie solo
// quelle voci e conserva i simboli, così i rapporti di crash restano leggibili anche senza il dSYM,
// che lo script non distribuisce. Lo strip avviene prima della firma. Le tre impostazioni stanno
// qui e non sulla riga di comando di xcodebuild: da lì varrebbero anche per gli oggetti `.o` dei
// pacchetti Swift, che lo strip non gestisce (con STRIP_STYLE = all fallisce).
DEPLOYMENT_POSTPROCESSING = YES
STRIP_INSTALLED_PRODUCT = YES
STRIP_STYLE = debugging
