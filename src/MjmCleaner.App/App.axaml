<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MjmCleaner.App.ViewModels"
             xmlns:views="clr-namespace:MjmCleaner.App.Views"
             x:Class="MjmCleaner.App.App"
             Name="mjm.cleaner"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#0A66D8" RegionColor="#F7F7F9" />
                <ColorPaletteResources x:Key="Dark" Accent="#0A66D8" RegionColor="#1E1E20" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://MjmCleaner.App/Styles/Icons.axaml" />
        <StyleInclude Source="avares://MjmCleaner.App/Styles/MacTheme.axaml" />
    </Application.Styles>

    <Application.DataTemplates>
        <DataTemplate DataType="vm:ChooseStepViewModel"><views:ChooseStepView /></DataTemplate>
        <DataTemplate DataType="vm:ScanStepViewModel"><views:ScanStepView /></DataTemplate>
        <DataTemplate DataType="vm:ConfirmStepViewModel"><views:ConfirmStepView /></DataTemplate>
        <DataTemplate DataType="vm:DoneStepViewModel"><views:DoneStepView /></DataTemplate>
        <DataTemplate DataType="vm:HistoryViewModel"><views:HistoryView /></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="vm:DockerViewModel"><views:DockerView /></DataTemplate>
        <DataTemplate DataType="vm:DockerReportViewModel"><views:DockerReportView /></DataTemplate>
        <DataTemplate DataType="vm:XcodeViewModel"><views:XcodeView /></DataTemplate>
        <DataTemplate DataType="vm:XcodeReportViewModel"><views:XcodeReportView /></DataTemplate>
    </Application.DataTemplates>
</Application>
