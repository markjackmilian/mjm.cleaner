<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MjmCleaner.App.ViewModels"
             x:Class="MjmCleaner.App.Views.ChooseStepView"
             x:DataType="vm:ChooseStepViewModel">

    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,20">
            <TextBlock Text="1 · Scegli   —   2 Analizza   —   3 Conferma   —   4 Fatto" Classes="Eyebrow" />
            <TextBlock Text="Cosa vuoi pulire?" Classes="PageTitle" />
            <TextBlock Text="Seleziona solo ciò che vuoi analizzare. Vedrai ogni elemento prima della rimozione." Classes="PageSubtitle" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Classes="SurfaceCard" Padding="12" Margin="0,18,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="L'analisi non elimina alcun file." Classes="Muted" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="Primary" Content="Analizza →" Command="{Binding AnalyzeCommand}" />
            </Grid>
        </Border>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Choices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:CategoryChoice">
                        <Border Margin="{Binding Indent}" Padding="14,12" Classes="SurfaceCard">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}"
                                               Classes="Muted"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="2" Classes="StatusPill" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RiskLabel}" Classes="Muted" FontSize="11" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
