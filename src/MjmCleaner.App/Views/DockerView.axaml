<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MjmCleaner.App.ViewModels"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             x:Class="MjmCleaner.App.Views.DockerView"
             x:DataType="vm:DockerViewModel">

    <UserControl.Styles>
        <!-- Pallino di stato «motore non raggiungibile»: pulsa lentamente tra opacità piena e 0,35, solo mentre la pill è visibile. -->
        <Style Selector="Border.StatusPill[IsVisible=True] Ellipse.StatusDot">
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Classes="Toolbar" chrome:WindowDecorationProperties.ElementRole="TitleBar">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="Pulizia Docker" Classes="ToolbarTitle" />
                    <TextBlock Text="Anteprima: nulla viene eliminato finché non premi «Elimina»." Classes="ToolbarSubtitle" />
                </StackPanel>
                <Border Grid.Column="1" Classes="StatusPill" IsVisible="{Binding HasError}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Classes="StatusDot" Width="7" Height="7" Fill="#8E8E93" VerticalAlignment="Center" />
                        <TextBlock Text="Motore non raggiungibile" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="ActionBar" IsVisible="{Binding IsReady}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding DeleteProgressText}"
                           IsVisible="{Binding IsDeleting}"
                           Classes="Muted" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Classes="Secondary" Content="Interrompi"
                            Command="{Binding CancelDeleteCommand}"
                            IsVisible="{Binding IsDeleting}" />
                    <Button Classes="Destructive" Content="{Binding TotalText, StringFormat='Elimina {0}'}"
                            Command="{Binding DeleteCommand}"
                            IsVisible="{Binding IsReady}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="32,0,32,12" Spacing="10">
            <Border IsVisible="{Binding IsReady}" Classes="Banner">
                <TextBlock TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           Text="Eliminazione definitiva: immagini e volumi eliminati non sono recuperabili. I volumi contengono dati." />
            </Border>

            <TextBlock Text="{Binding DeleteErrorText}"
                       IsVisible="{Binding HasDeleteError}"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Panel>
            <StackPanel IsVisible="{Binding IsLoading}" Spacing="10" VerticalAlignment="Center" MaxWidth="420">
                <ProgressBar IsIndeterminate="True" />
                <TextBlock Text="Analisi di Docker e delle cartelle progetto in corso…" Classes="Muted" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Stato vuoto: motore non raggiungibile. -->
            <StackPanel IsVisible="{Binding HasError}" Width="380" Margin="0,-24,0,0" Spacing="14"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="18" Background="{DynamicResource WellBrush}" HorizontalAlignment="Center">
                    <Viewbox Width="36" Height="36">
                        <Path Classes="Icon" Data="{StaticResource IconCube}"
                              Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.4" />
                    </Viewbox>
                </Border>
                <TextBlock Text="{Binding ErrorText}" FontSize="17" FontWeight="SemiBold"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <Button Classes="Primary" Content="Riprova" Command="{Binding RetryCommand}"
                        HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>

            <ScrollViewer IsVisible="{Binding IsReady}">
                <StackPanel Margin="32,24,32,20" Spacing="12">
                    <Border Classes="SurfaceCard" Padding="16,12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding ServerText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DiskText}" Classes="Muted" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DfText}" Classes="Muted" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:DockerGroupNode">
                                <Expander IsExpanded="{Binding IsExpanded, Mode=OneTime}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SummaryText}" Classes="Muted" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>

                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Description}" Classes="Muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="1"
                                                      IsVisible="{Binding ShowGroupCheckBox}"
                                                      IsChecked="{Binding IsSelected}"
                                                      Content="{Binding GroupCheckBoxLabel}"
                                                      Margin="12,0,0,0" />
                                        </Grid>

                                        <!-- Stessa scelta del passo di conferma: ListBox virtualizza, MaxHeight le dà un riquadro finito. -->
                                        <ListBox ItemsSource="{Binding Rows}" MaxHeight="360">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="vm:DockerRow">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="8,5">
                                                        <CheckBox Grid.Column="0"
                                                                  IsVisible="{Binding ShowCheckBox}"
                                                                  IsChecked="{Binding IsSelected}"
                                                                  VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Margin="8,0" Spacing="2">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding DetailText}" Classes="Muted" FontSize="11" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Classes="StatusPill" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding KindLabel}" Classes="Muted" FontSize="11" />
                                                        </Border>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding SizeText}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
