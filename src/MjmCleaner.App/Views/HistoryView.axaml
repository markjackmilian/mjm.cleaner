<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MjmCleaner.App.ViewModels"
             x:Class="MjmCleaner.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="5" Margin="0,0,0,18">
            <TextBlock Text="Storico delle pulizie" Classes="PageTitle" />
            <TextBlock Text="Le pulizie completate e lo spazio effettivamente recuperato." Classes="PageSubtitle" />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Classes="Secondary" Content="Chiudi" Command="{Binding CloseCommand}"
                HorizontalAlignment="Right" Margin="0,14,0,0" />

        <Border Classes="SurfaceCard">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="130,100,*,110" Margin="14,10" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Text="DATA" Classes="Eyebrow" />
                    <TextBlock Grid.Column="1" Text="SPAZIO" Classes="Eyebrow" />
                    <TextBlock Grid.Column="2" Text="CATEGORIE" Classes="Eyebrow" />
                    <TextBlock Grid.Column="3" Text="ELEMENTI" Classes="Eyebrow" />
                </Grid>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:HistoryRow">
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                                    <Grid ColumnDefinitions="130,100,*,110" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0" Text="{Binding When}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Freed}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Categories}" Classes="Muted" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Items}" Classes="Muted" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
