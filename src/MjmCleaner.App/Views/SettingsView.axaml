<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MjmCleaner.App.ViewModels"
             x:Class="MjmCleaner.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="5" Margin="0,0,0,18">
            <TextBlock Text="Impostazioni" Classes="PageTitle" />
            <TextBlock Text="Personalizza i percorsi e le soglie usate durante l'analisi." Classes="PageSubtitle" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="10" Margin="0,14,0,0">
            <Button Classes="Secondary" Content="Annulla" Command="{Binding CancelCommand}" />
            <Button Classes="Primary" Content="Salva" Command="{Binding SaveCommand}" />
        </StackPanel>

        <ScrollViewer>
            <StackPanel Spacing="14">
                <Border Classes="SurfaceCard" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Progetti .NET" Classes="FieldLabel" />
                        <TextBlock Text="Cartelle di progetto per bin e obj, una per riga." Classes="PageSubtitle" />
                        <TextBox Text="{Binding ProjectRoots}" AcceptsReturn="True" Height="80" />
                    </StackPanel>
                </Border>

                <Border Classes="SurfaceCard" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="File grandi" Classes="FieldLabel" />
                        <TextBlock Text="Cartelle in cui cercare file grandi, una per riga." Classes="PageSubtitle" />
                        <TextBox Text="{Binding LargeFileRoots}" AcceptsReturn="True" Height="60" />
                        <StackPanel Spacing="4" Margin="0,6,0,0">
                            <TextBlock Text="Soglia file grandi (MB)" Classes="FieldLabel" />
                            <NumericUpDown Value="{Binding LargeFileThresholdMegabytes}" Minimum="1" Maximum="100000" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="SurfaceCard" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Età minima" Classes="FieldLabel" />
                        <TextBlock Text="I file più recenti restano esclusi dall'analisi." Classes="PageSubtitle" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="10">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                        <TextBlock Text="Download (giorni)" Classes="FieldLabel" />
                        <NumericUpDown Value="{Binding DownloadsMinAgeDays}" Minimum="0" Maximum="3650" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                        <TextBlock Text="Log (giorni)" Classes="FieldLabel" />
                        <NumericUpDown Value="{Binding LogsMinAgeDays}" Minimum="0" Maximum="3650" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                        <TextBlock Text="Pacchetti NuGet (giorni)" Classes="FieldLabel" />
                        <NumericUpDown Value="{Binding NuGetMinAgeDays}" Minimum="0" Maximum="3650" />
                    </StackPanel>
                        </Grid>

                <TextBlock Classes="Muted" FontSize="11" TextWrapping="Wrap"
                           Text="L'età dei pacchetti NuGet si basa sull'ultimo accesso registrato dal filesystem: è un'euristica, non una certezza." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
