<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MjmCleaner.App.ViewModels"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             x:Class="MjmCleaner.App.Views.XcodeReportView"
             x:DataType="vm:XcodeReportViewModel">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Classes="Toolbar" chrome:WindowDecorationProperties.ElementRole="TitleBar">
            <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="Report pulizia" Classes="ToolbarTitle" />
                <TextBlock Text="{Binding SummaryText}" Classes="ToolbarSubtitle" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="ActionBar">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Classes="Primary" Content="Nuova analisi Xcode" Command="{Binding AnalyzeAgainCommand}" />
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="32,0,32,12" Spacing="6">
            <TextBlock Text="{Binding FreedText}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding FreeSpaceText}" Classes="Muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding WarningsText}" IsVisible="{Binding HasWarnings}" Classes="Muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding HistoryWarning}" IsVisible="{Binding HasHistoryWarning}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer>
            <Border Classes="SurfaceCard" Margin="32,24,32,20" VerticalAlignment="Top">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.Styles>
                        <!-- Il separatore sta sopra ogni riga tranne la prima. -->
                        <Style Selector="ContentPresenter:nth-child(1) Border.Separator">
                            <Setter Property="IsVisible" Value="False" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:XcodeResultRow">
                            <StackPanel>
                                <Border Classes="Separator" Margin="16,0,0,0" />
                                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" Margin="16,10">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding OutcomeText}" Classes="Muted" Margin="8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Identity}" Classes="Muted" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding Detail}" Classes="Muted" FontSize="11" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </ScrollViewer>
    </DockPanel>
</UserControl>
